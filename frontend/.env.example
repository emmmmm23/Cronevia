# Only public browser configuration may use VITE_. Never place a service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key
# Public browser map keys must have HTTP-referrer/API/quota restrictions.
VITE_GOOGLE_MAPS_API_KEY=
VITE_MAPBOX_ACCESS_TOKEN=
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
VITE_SENTRY_DSN=
# Server-only configuration belongs in Vercel's environment settings, never VITE_*.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_supabase_publishable_key
# GEOAPIFY_API_KEY=your_server_provider_key
# APP_ORIGIN=https://your-production-origin.example
