APP_NAME=Cronevia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cronevia
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci

DB_TEST_DATABASE=cronevia_test
DB_TEST_USERNAME=
DB_TEST_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto

RESEND_API_KEY=
MAIL_FROM_ADDRESS=noreply@cronevia.com
MAIL_FROM_NAME=Cronevia

SENTRY_LARAVEL_DSN=
FRONTEND_URL=http://localhost:5173

# SUPER ADMIN CONFIGURATION
# ========================
# SUPER_ADMIN_SETUP_ENABLED controls server-side Super Admin provisioning.
# 
# SECURITY IMPORTANT:
# - Set to 'false' in production
# - Set to 'true' ONLY during initial development setup
# - After first Super Admin is created, set to 'false'
# - Super Admin provisioning is ALWAYS server-side only via Artisan command:
#   php artisan cronevia:create-super-admin
#
# This flag is for future development of web-based setup UI (if needed).
# For now, use the Artisan command exclusively.
SUPER_ADMIN_SETUP_ENABLED=false
