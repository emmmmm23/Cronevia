# Server-only Vercel function settings. Keep actual values in Vercel environment settings.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_key
GEOAPIFY_API_KEY=your_server_provider_key
APP_ORIGIN=https://your-production-origin.example
# Browser configuration placeholders are in frontend/.env.example.
# A Supabase service-role key is not needed by the current Vercel function.
