# ============================================================
# CRONEVIA Environment Variables
# ============================================================

# Legacy Laravel API (Will be phased out during migration)
VITE_API_URL=http://localhost:8000

# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
VITE_SUPABASE_URL=your-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# IMPORTANT SECURITY NOTES:
# 1. VITE_SUPABASE_ANON_KEY is SAFE to expose in frontend (RLS protects data)
# 2. NEVER put SUPABASE_SERVICE_ROLE_KEY in frontend .env (it bypasses RLS)
# 3. Service role key should only be used in backend/server environments
# 4. The anon key only works with Row Level Security policies enabled

# Optional: Sentry for error tracking
VITE_SENTRY_DSN=
